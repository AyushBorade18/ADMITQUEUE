# Public address of the site (used in email links). Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true  = fictional (synthetic) CAP records are linked automatically when a student registers with their CAP ID.
# false = every claim on an existing record waits for staff approval. Keep false for anything with real data.
DEMO_MODE=false

# ---- Admin bootstrap (used ONLY by `npm run admin:bootstrap`, never read by the website) -----------------
ADMIN_LOGIN_ID=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-password
