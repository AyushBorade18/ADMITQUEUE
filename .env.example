# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# The same three Supabase values go into the Render "Environment" tab.

# ---- Supabase (Project settings -> API Keys) ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (safe for the browser). Starts with sb_publishable_ (a legacy "anon" key also works).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret key (SERVER ONLY, never expose). Starts with sb_secret_ (a legacy "service_role" key also works).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- App ------------------------------------------------------------------------------------------------
# Public address of the site. Local: http://localhost:3000   Render: https://your-service.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Optional -------------------------------------------------------------------------------------------
# Direct Postgres connection string, only for `npm run db:migrate` (Project settings -> Database).
SUPABASE_DB_URL=
# Absolute path of the C++ engine, only if you keep the executable somewhere else.
ENGINE_PATH=
